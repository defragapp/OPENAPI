# Documentation only. Use Cloudflare Worker secrets and bindings in production.
AI_PROVIDER=cloudflare-gateway
AI_GATEWAY_ID=sovereign-ai-gateway
AI_MODEL=@cf/zai-org/glm-4.7-flash
AI_FREE_MONTHLY_TURNS=10
AI_SOVEREIGN_PLUS_MONTHLY_TURNS=300

# Cloudflare account and repository-owned deploy configuration.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WORKERS_CI_COMMIT_SHA=
VITE_TURNSTILE_SITE_KEY=

# Runtime secrets belong in Cloudflare encrypted Worker secrets.
SESSION_SIGNING_SECRET=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

STRIPE_PRICE_SOVEREIGN_PLUS_MONTHLY=
STRIPE_PRICE_SOVEREIGN_PLUS_ANNUAL=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
SCRIPTURE_TRANSLATION=WEB
SOVV_INTERNAL_BASE_URL=
SOVV_INTERNAL_AUTH_TOKEN=

# Configure the optional private BASELINE service binding in Cloudflare.
# Without it, onboarding fails closed as unavailable.

# Preview deployment variables. Use only in a secure preview environment.
PREVIEW_WORKER_NAME=sovereign-openapi-preview
PREVIEW_D1_NAME=sovereign-openapi-preview-db
PREVIEW_BASE_URL=
PREVIEW_SESSION_SIGNING_SECRET=

# Never commit populated values from this file.
