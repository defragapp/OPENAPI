# Documentation only. Use Cloudflare Worker secrets/bindings in production.
AI_PROVIDER=cloudflare-gateway
AI_GATEWAY_ID=sovereign
AI_MODEL=openai/gpt-5.5
AI_FREE_MONTHLY_TURNS=10
AI_SOVEREIGN_PLUS_MONTHLY_TURNS=300
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN is only for GitHub Actions REST smoke verification; production Workers should prefer the AI binding.

SESSION_SIGNING_SECRET=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=

# Google OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.defrag.app/api/v1/auth/oauth/google/callback

# Sign in with Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://app.defrag.app/api/v1/auth/oauth/apple/callback

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOVEREIGN_PLUS_MONTHLY=
STRIPE_PRICE_SOVEREIGN_PLUS_ANNUAL=
STRIPE_SUCCESS_URL=https://app.defrag.app/app?billing=success
STRIPE_CANCEL_URL=https://app.defrag.app/onboarding?billing=cancelled
STRIPE_PORTAL_RETURN_URL=https://app.defrag.app/app?billing=portal
SCRIPTURE_TRANSLATION=WEB
SOVV_INTERNAL_BASE_URL=
SOVV_INTERNAL_AUTH_TOKEN=
# Configure the optional private BASELINE service binding in Cloudflare. Without it, onboarding fails closed as unavailable.
# Preview deployment variables (non-secret; configure in GitHub Actions variables)
PREVIEW_WORKER_NAME=sovereign-openapi-preview
PREVIEW_D1_NAME=sovereign-openapi-preview-db
PREVIEW_BASE_URL=
# PREVIEW_SESSION_SIGNING_SECRET is a secret; do not commit a value.
