{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sovv-web",
  "account_id": "8b1954d216d65077c6480d62583fe2c2",
  "main": "apps/sovereign-worker/src/production-entry.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "routes": [
    {
      "pattern": "sovereign.defrag.app",
      "custom_domain": true
    },
    {
      "pattern": "app.defrag.app",
      "custom_domain": true
    },
    {
      "pattern": "defrag.app/*",
      "zone_name": "defrag.app"
    },
    {
      "pattern": "www.defrag.app/*",
      "zone_name": "defrag.app"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_VERSION": "304f64dcdc45b955fc0fe3c6970df79bc497416b",
    "PUBLIC_APP_URL": "https://app.defrag.app",
    "PUBLIC_CONTACT_EMAIL": "info@sovereign.defrag.app",
    "TRANSACTIONAL_FROM_EMAIL": "info@sovereign.defrag.app",
    "AI_PROVIDER": "cloudflare-gateway",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "AI_GATEWAY_ID": "sovereign-ai-gateway",
    "WORKERS_AI_DAILY_NEURON_BUDGET": "7500",
    "AI_FREE_MONTHLY_TURNS": "10",
    "AI_SOVEREIGN_PLUS_MONTHLY_TURNS": "300",
    "WORLDS_VIDEO_ENABLED": "false",
    "WORLDS_VIDEO_MODEL": "runwayml/gen-4.5",
    "WORLDS_VIDEO_TURN_COST": "25",
    "THREAD_RETENTION_DAYS": "30",
    "AUDIT_RETENTION_DAYS": "90",
    "STRIPE_PRICE_SOVEREIGN_PLUS_MONTHLY": "price_1Te0g9Bk78yJ8Hww8fFZCqhm",
    "STRIPE_PRICE_SOVEREIGN_PLUS_ANNUAL": "price_1Tq6nPBk78yJ8Hwwm0pxg4hH",
    "STRIPE_SUCCESS_URL": "https://app.defrag.app/app?billing=success",
    "STRIPE_CANCEL_URL": "https://app.defrag.app/app?billing=cancelled",
    "STRIPE_PORTAL_RETURN_URL": "https://app.defrag.app/app?billing=portal",
    "TURNSTILE_EXPECTED_HOSTNAME": "app.defrag.app",
    "SCRIPTURE_TRANSLATION": "WEB",
    "BASELINE_HORIZONS_URL": "https://ssd.jpl.nasa.gov/api/horizons.api",
    "BASELINE_PROVIDER_TIMEOUT_MS": "8000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sovereign-openapi-db",
      "database_id": "497e5df9-c82a-499e-9be6-d809c992e8ce",
      "migrations_dir": "apps/sovereign-worker/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "THREADS",
        "class_name": "ThreadCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "openapi-production-v1",
      "new_sqlite_classes": [
        "ThreadCoordinator"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/internal/*",
      "/health",
      "/healthz",
      "/ready",
      "/",
      "/login",
      "/signup",
      "/onboarding",
      "/app",
      "/app/*",
      "/auth/*",
      "/invitation",
      "/consent.html",
      "/privacy",
      "/terms",
      "/pricing",
      "/pricing.html",
      "/faq",
      "/faq.html",
      "/questions",
      "/how-it-works",
      "/how-it-works.html"
    ]
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
