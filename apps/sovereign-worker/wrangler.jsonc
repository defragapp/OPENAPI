{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sovereign-agent",
  "main": "src/runtime-entry.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "APP_VERSION": "0.0.1-dev",
    "AI_PROVIDER": "cloudflare-gateway",
    "AI_MODEL": "openai/gpt-5.5",
    "AI_GATEWAY_ID": "sovereign",
    "AI_FREE_MONTHLY_TURNS": "10",
    "AI_SOVEREIGN_PLUS_MONTHLY_TURNS": "300",
    "THREAD_RETENTION_DAYS": "30",
    "AUDIT_RETENTION_DAYS": "90",
    "BASELINE_HORIZONS_URL": "https://ssd.jpl.nasa.gov/api/horizons.api",
    "BASELINE_PROVIDER_TIMEOUT_MS": "8000"
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "THREADS",
        "class_name": "ThreadCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ThreadCoordinator"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/healthz",
      "/ready",
      "/questions"
    ]
  },
  "env": {
    "preview": {
      "name": "sovereign-openapi-preview",
      "compatibility_date": "2026-07-20",
      "compatibility_flags": [
        "nodejs_compat"
      ],
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": true
      },
      "vars": {
        "APP_ENV": "preview",
        "APP_VERSION": "0.0.1-preview",
        "AI_PROVIDER": "cloudflare-gateway",
        "AI_MODEL": "openai/gpt-5.5",
        "AI_GATEWAY_ID": "sovereign",
        "AI_FREE_MONTHLY_TURNS": "10",
        "AI_SOVEREIGN_PLUS_MONTHLY_TURNS": "300",
        "THREAD_RETENTION_DAYS": "30",
        "AUDIT_RETENTION_DAYS": "90",
        "SOVV_INTERNAL_BASE_URL": "",
        "STRIPE_SUCCESS_URL": "https://sovereign-openapi-preview.sovereign-os-api.workers.dev/app?billing=success",
        "STRIPE_CANCEL_URL": "https://sovereign-openapi-preview.sovereign-os-api.workers.dev/app?billing=cancelled",
        "STRIPE_PORTAL_RETURN_URL": "https://sovereign-openapi-preview.sovereign-os-api.workers.dev/app?billing=portal",
        "SCRIPTURE_TRANSLATION": "WEB",
        "BASELINE_HORIZONS_URL": "https://ssd.jpl.nasa.gov/api/horizons.api",
        "BASELINE_PROVIDER_TIMEOUT_MS": "8000"
      },
      "d1_databases": [
        {
          "binding": "DB"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "THREADS",
            "class_name": "ThreadCoordinator"
          }
        ]
      },
      "migrations": [
        {
          "tag": "preview-v1",
          "new_sqlite_classes": [
            "ThreadCoordinator"
          ]
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/health",
          "/healthz",
          "/ready",
          "/questions"
        ]
      },
      "triggers": {
        "crons": [
          "*/15 * * * *"
        ]
      }
    }
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
